# syntax=docker/dockerfile:1
#
# The worker is a second entrypoint into @nagihin/api (src/worker.main.ts),
# not a separate package — see apps/api/src/worker.module.ts. Still its own
# image/process/container: event-loop isolation from the HTTP API is the
# whole point (.docs/02-architecture.md §6), it just no longer needs a
# duplicated config/Prisma/Redis tree to get it.
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY web/package.json web/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm exec prisma generate
RUN pnpm --filter @nagihin/api run build

FROM base AS runtime
ENV NODE_ENV=production
RUN addgroup -S nagihin && adduser -S nagihin -G nagihin

COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/package.json ./package.json
COPY --from=build /repo/prisma ./prisma
COPY --from=build /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /repo/apps/api/package.json ./apps/api/package.json
COPY --from=build /repo/apps/api/dist ./apps/api/dist

USER nagihin
WORKDIR /repo/apps/api
CMD ["node", "dist/worker.main.js"]
