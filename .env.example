# --- App ---
NODE_ENV=development
PORT=3001

# --- Database (Postgres) ---
# Local docker-compose: postgresql://nagihin:nagihin@localhost:5432/nagihin
# Later on the VPS: point both at the same self-hosted Postgres (no pooler needed
# outside of Supabase-hosted Postgres, but the two variables are kept distinct so
# migrations always run through a direct/session connection).
DATABASE_URL=postgresql://nagihin:nagihin@localhost:5432/nagihin
DIRECT_DATABASE_URL=postgresql://nagihin:nagihin@localhost:5432/nagihin

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Supabase (Storage only — Postgres is self-hosted, see above) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PUBLIC=nagihin-public
SUPABASE_BUCKET_PRIVATE=nagihin-private

# --- CORS / frontend ---
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Swagger basic auth (production only; leave blank locally) ---
SWAGGER_USER=
SWAGGER_PASSWORD=

# --- JWT (RS256) ---
# Generate a dev keypair:
#   openssl genrsa -out /tmp/rsa.pem 2048
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in /tmp/rsa.pem -out /tmp/private.pem
#   openssl rsa -in /tmp/rsa.pem -pubout -out /tmp/public.pem
# Then paste each PEM in as a single line with real newlines replaced by literal \n.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=dev-1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# --- Email (Resend) — blank locally logs a dry-run instead of sending ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@nagihin.id

# --- Auth rate limiting ---
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_SECONDS=60
