# --- App ---
NODE_ENV=development
PORT=3001

# --- Database (Postgres) ---
# Local docker-compose: postgresql://nagihin:nagihin@localhost:5432/nagihin
# Later on the VPS: point both at the same self-hosted Postgres (no pooler needed
# outside of Supabase-hosted Postgres, but the two variables are kept distinct so
# migrations always run through a direct/session connection).
DATABASE_URL=postgresql://nagihin:nagihin@localhost:5432/nagihin
DIRECT_DATABASE_URL=postgresql://nagihin:nagihin@localhost:5432/nagihin

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Supabase (Storage only — Postgres is self-hosted, see above) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PUBLIC=nagihin-public
SUPABASE_BUCKET_PRIVATE=nagihin-private

# --- CORS / frontend ---
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Swagger basic auth (production only; leave blank locally) ---
SWAGGER_USER=
SWAGGER_PASSWORD=
