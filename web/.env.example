# --- API ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Server-only: used for SSR fetches. In Docker this points at the api service
# (http://api:3001/api/v1) instead of localhost.
API_INTERNAL_URL=http://localhost:3001/api/v1

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Identity Services (account linking from /dashboard/pengaturan) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Supabase Storage image hostname (feeds next.config.ts images.remotePatterns) ---
NEXT_PUBLIC_SUPABASE_IMAGE_HOSTNAME=

# --- Midtrans Snap (checkout) — blank locally matches the API's stub Snap
# gateway; the checkout page skips loading the Snap.js SDK for stub tokens ---
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
