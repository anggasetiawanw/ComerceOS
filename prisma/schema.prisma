generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgcrypto, citext]
}

enum UserRole {
  buyer
  seller
  admin
}

enum TokenPurpose {
  email_verification
  password_reset
}

enum StorePlan {
  free
  pro
}

enum SettlementMode {
  auto
  manual
}

enum ProductType {
  digital
  physical
  service
}

enum ProductStatus {
  active
  draft
  archived
}

enum OrderSource {
  self_checkout
  manual
}

// Sprint 9 — Path B. Deliberately not an order status (.docs/06-database-roadmap.md
// §2.1, AD-08): an inquiry has no money, no items, and often never becomes an order.
enum InquiryStatus {
  open
  converted
  lost
}

enum OrderStatus {
  pending_payment
  paid
  holding
  released
  disputed
  refunded
  cancelled
  expired
}

enum StatusActorType {
  system
  seller
  buyer
  admin
}

enum WebhookEventStatus {
  received
  processed
  failed
  ignored
}

enum OutboxStatus {
  pending
  processing
  published
  failed
}

enum BalanceTransactionType {
  order_paid_holding
  order_released
  withdrawal_paid
  refund_debit
  promo_adjustment
}

enum WithdrawalStatus {
  requested
  approved
  paid
  rejected
}

// Sprint 7 — Administration. Distinct from StatusActorType (order-history
// actors: system/seller/buyer/admin) — audit_logs uses the coarser
// user/admin/system split from .docs/brief/database-schema.md's audit_logs
// table, where 'user' covers both buyer and seller actions.
enum ActorType {
  user
  admin
  system
}

enum InvoiceSentVia {
  wa
  email
  both
}

enum NotificationChannelType {
  email
  whatsapp
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
  skipped
}

// Identity — Sprint 2. IDs are UUIDv7 generated in application code
// (shared/kernel/uuid.ts), never a database default.
model User {
  id              String    @id
  googleId        String?   @unique @map("google_id")
  email           String    @unique @db.Citext
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  name            String
  avatarUrl       String?   @map("avatar_url")
  phone           String?
  role            UserRole  @default(buyer)
  createdAt       DateTime  @default(now()) @map("created_at")

  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  store               Store?
  orders              Order[]
  orderStatusChanges  OrderStatusHistory[]
  storeBuyerRecords   StoreBuyer[]
  auditLogs           AuditLog[]
  reviewedWithdrawals Withdrawal[]
  inquiries           Inquiry[]

  @@map("users")
}

model RefreshToken {
  id           String    @id
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String       @id
  userId    String       @map("user_id")
  tokenHash String       @unique @map("token_hash")
  purpose   TokenPurpose
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// Store — Sprint 3. IDs are UUIDv7 generated in application code
// (shared/kernel/uuid.ts), never a database default. holding_balance and
// available_balance are ledger-owned caches (AD-06): the only file that may
// write them is modules/ledger/infrastructure/persistence/store-balance.prisma.repository.ts
// (plus StoreMapper.toPersistenceCreate, which zero-initialises at store
// creation) — see Sprint 6's architecture.spec.ts fence. invoice_counter is
// likewise owned by modules/invoicing/infrastructure/persistence/invoice-number.prisma.allocator.ts.
model Store {
  id               String         @id
  ownerId          String         @unique @map("owner_id")
  username         String         @unique @db.Citext
  displayName      String         @map("display_name")
  bio              String?
  avatarUrl        String?        @map("avatar_url")
  bannerUrl        String?        @map("banner_url")
  theme            Json?
  customDomain     String?        @unique @map("custom_domain")
  plan             StorePlan      @default(free)
  settlementMode   SettlementMode @default(auto) @map("settlement_mode")
  // Sprint 9 — Path B. Nullable: the WA deep link (Tanya button) and the
  // inquiry notification recipient are both unavailable until the seller
  // sets this. Stored normalized (628xxxxxxxxxx) via shared/kernel/value-objects/phone.vo.ts.
  whatsappNumber   String?        @map("whatsapp_number")
  holdingBalance   BigInt         @default(0) @map("holding_balance")
  availableBalance BigInt         @default(0) @map("available_balance")
  invoiceCounter   Int            @default(0) @map("invoice_counter")
  createdAt        DateTime       @default(now()) @map("created_at")

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  socialLinks         SocialLink[]
  products            Product[]
  orders              Order[]
  inquiries           Inquiry[]
  balanceTransactions BalanceTransaction[]
  bankAccounts        BankAccount[]
  withdrawals         Withdrawal[]
  invoices            Invoice[]
  storeBuyers         StoreBuyer[]

  @@map("stores")
}

model SocialLink {
  id       String @id
  storeId  String @map("store_id")
  platform String
  url      String
  position Int

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("social_links")
}

// Catalog — Sprint 4. IDs are UUIDv7 generated in application code
// (shared/kernel/uuid.ts), never a database default. price/hpp are BIGINT
// rupiah integers (AD-04), not numeric — see shared/kernel/value-objects/money.vo.ts.
// products.store_id is ON DELETE RESTRICT: order_items will reference products
// by ID (Sprint 5, also RESTRICT), and products are archived, never hard-deleted
// (.docs/06-database-roadmap.md §4, .docs/03-bounded-contexts.md §3.3).
model Product {
  id          String        @id
  storeId     String        @map("store_id")
  name        String
  slug        String
  description String?
  price       BigInt
  hpp         BigInt?
  productType ProductType   @map("product_type")
  stock       Int?
  images      Json          @default("[]")
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  digitalFiles DigitalFile[]
  orderItems   OrderItem[]
  inquiries    Inquiry[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@map("products")
}

// digital_files gains file_name/size_bytes/content_type beyond the documented
// spec — needed for Content-Disposition on signed-URL downloads (Sprint 5/6)
// and a usable files list in the dashboard. size_bytes is Int, not BigInt, so
// it never needs bigint-safe JSON handling.
model DigitalFile {
  id           String   @id
  productId    String   @map("product_id")
  filePath     String   @map("file_path")
  fileName     String   @map("file_name")
  sizeBytes    Int      @map("size_bytes")
  contentType  String   @map("content_type")
  maxDownloads Int      @default(3) @map("max_downloads")
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("digital_files")
}

// Ordering — Sprint 5. IDs are UUIDv7 generated in application code. Money
// columns are BIGINT rupiah integers (AD-04); platform_fee_rate stays a
// numeric(5,4) rate, not money. order_number is a globally unique
// human-readable code (not a per-store counter) because Midtrans requires
// uniqueness per merchant, not per store. orders.store_id / orders.buyer_id
// are ON DELETE RESTRICT — the financial record must survive
// (.docs/06-database-roadmap.md §4). No ledger writes yet: holding_until is
// computed and status moves to 'holding', but balance_transactions and
// stores.holding_balance stay untouched until Sprint 6.
model Order {
  id                    String      @id
  orderNumber           String      @unique @map("order_number")
  storeId               String      @map("store_id")
  buyerId               String      @map("buyer_id")
  source                OrderSource
  status                OrderStatus @default(pending_payment)
  // Sprint 9 — set only when source = manual and the order was created via
  // POST /inquiries/:id/convert. Nullable FK, added as a non-blocking ALTER
  // TABLE ADD COLUMN (.docs/06-database-roadmap.md §1).
  inquiryId             String?     @map("inquiry_id")
  subtotal              BigInt
  discountCode          String?     @map("discount_code")
  discountAmount        BigInt      @default(0) @map("discount_amount")
  total                 BigInt
  platformFeeRate       Decimal     @map("platform_fee_rate") @db.Decimal(5, 4)
  platformFeeAmount     BigInt      @map("platform_fee_amount")
  paymentMethod         String?     @map("payment_method")
  midtransTransactionId String?     @map("midtrans_transaction_id")
  shippingAddress       Json?       @map("shipping_address")
  paidAt                DateTime?   @map("paid_at")
  holdingUntil          DateTime?   @map("holding_until")
  releasedAt            DateTime?   @map("released_at")
  createdAt             DateTime    @default(now()) @map("created_at")

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  buyer               User                 @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  inquiry              Inquiry?             @relation("InquiryConvertedOrder", fields: [inquiryId], references: [id], onDelete: SetNull)
  convertedFromInquiry Inquiry?             @relation("InquiryConversionSource")
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  webhookEvents       WebhookEvent[]
  balanceTransactions BalanceTransaction[]
  invoice             Invoice?

  @@index([storeId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([buyerId, createdAt])
  @@index([midtransTransactionId])
  @@index([status, holdingUntil])
  @@index([inquiryId])
  @@map("orders")
}

// Sprint 9 — Path B. The chat-first flow: a storefront visitor clicks
// "Tanya dulu via WA", which records this row and returns a wa.me deep
// link. No buyer contact fields (.docs/brief/database-schema.md) — the
// seller matches an inquiry to their WA inbox by product and timing, and
// the buyer only lands in the database for real once converted.
model Inquiry {
  id                String        @id
  storeId           String        @map("store_id")
  productId         String?       @map("product_id")
  buyerId           String?       @map("buyer_id")
  status            InquiryStatus @default(open)
  convertedOrderId  String?       @unique @map("converted_order_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  store           Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product         Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer           User?    @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  convertedOrder  Order?   @relation("InquiryConversionSource", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  orders          Order[]  @relation("InquiryConvertedOrder")

  @@index([storeId, status, createdAt])
  @@map("inquiries")
}

// order_items snapshot product data at purchase time so a later product edit
// (or HPP change) never alters a historical order. order_items.product_id is
// ON DELETE RESTRICT — products archive, never hard-delete
// (.docs/06-database-roadmap.md §4).
model OrderItem {
  id                  String   @id
  orderId             String   @map("order_id")
  productId           String   @map("product_id")
  productNameSnapshot String   @map("product_name_snapshot")
  productTypeSnapshot String   @map("product_type_snapshot")
  priceSnapshot       BigInt   @map("price_snapshot")
  hppSnapshot         BigInt?  @map("hpp_snapshot")
  qty                 Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at")

  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveries DigitalDelivery[]

  @@index([orderId])
  @@index([productId, createdAt])
  @@map("order_items")
}

// order_status_history complements balance_transactions (money) with a
// record of every state transition — from_status/to_status are stored as
// text, not the OrderStatus enum, so history survives a future enum change.
model OrderStatusHistory {
  id            String          @id
  orderId       String          @map("order_id")
  fromStatus    String?         @map("from_status")
  toStatus      String          @map("to_status")
  changedByType StatusActorType @map("changed_by_type")
  changedById   String?         @map("changed_by_id")
  reason        String?
  createdAt     DateTime        @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// webhook_events is the raw record of every Midtrans notification, persisted
// before interpretation. Deliberately no unique constraint on
// (source, transaction_id, transaction_status) — a duplicate delivery must be
// recorded and then marked 'ignored', never rejected at the database and
// lost (.docs/09-payments-ledger.md §3). transaction_id/transaction_status
// are extracted into real columns (rather than an expression index on the
// jsonb payload) so the dedup lookup is a plain indexed query.
model WebhookEvent {
  id                String             @id
  source            String
  eventType         String?            @map("event_type")
  payload           Json
  orderId           String?            @map("order_id")
  transactionId     String?            @map("transaction_id")
  transactionStatus String?            @map("transaction_status")
  status            WebhookEventStatus @default(received)
  errorMessage      String?            @map("error_message")
  receivedAt        DateTime           @default(now()) @map("received_at")
  processedAt       DateTime?          @map("processed_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([source, transactionId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// digital_deliveries — one row per (order_item, digital_file) so a
// multi-file product provisions independently per file. The signed URL
// itself is never persisted; it is generated on demand and expires
// separately from the download entitlement (.docs/06-database-roadmap.md
// §2.7): expires_at bounds the signed URL window, not the buyer's right to
// redownload while download_count < max_downloads.
model DigitalDelivery {
  id            String   @id
  orderItemId   String   @map("order_item_id")
  filePath      String   @map("file_path")
  downloadCount Int      @default(0) @map("download_count")
  maxDownloads  Int      @map("max_downloads")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, filePath])
  @@map("digital_deliveries")
}

// outbox_events — the transactional outbox (AD-05). A relay in the worker
// polls (status, available_at), publishes to BullMQ, and marks published.
// The (status, available_at) index is the relay's only query and the
// hottest small query in the system (.docs/06-database-roadmap.md §2.11).
model OutboxEvent {
  id            String       @id
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  publishedAt   DateTime?    @map("published_at")
  error         String?
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

// idempotency_keys backs the HTTP Idempotency-Key layer for POST /checkout
// (and, from Sprint 7, POST /withdrawals). A replay of (key, user_id) with
// the same request hash returns the stored response; a different hash is a
// 409 Conflict (.docs/09-payments-ledger.md §3).
model IdempotencyKey {
  id             String   @id
  key            String
  userId         String   @map("user_id")
  endpoint       String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([key, userId])
  @@map("idempotency_keys")
}

// Ledger — Sprint 6 (migration 007). Append-only: no application code ever
// updates or deletes a row here (.docs/09-payments-ledger.md §4). Every row
// carries the resulting store balances (holding_balance_after /
// available_balance_after) so any single row is independently verifiable.
// holding_delta / available_delta are a documented deviation from
// .docs/brief/database-schema.md's single signed "amount" column — the
// order_released movement affects both holding and available in one entry,
// which one signed column cannot express (see .docs/09 §4's worked example:
// "-95.000 / +95.000"). "amount" stays the unambiguous display magnitude.
// FKs onto orders/stores/withdrawals are RESTRICT — the ledger is immutable
// and nothing may delete out from under it.
model BalanceTransaction {
  id                    String                 @id
  storeId               String                 @map("store_id")
  orderId               String?                @map("order_id")
  withdrawalId          String?                @map("withdrawal_id")
  type                  BalanceTransactionType
  amount                BigInt
  holdingDelta          BigInt                 @default(0) @map("holding_delta")
  availableDelta        BigInt                 @default(0) @map("available_delta")
  holdingBalanceAfter   BigInt                 @map("holding_balance_after")
  availableBalanceAfter BigInt                 @map("available_balance_after")
  note                  String?
  createdAt             DateTime               @default(now()) @map("created_at")

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@index([orderId])
  @@map("balance_transactions")
}

// bank_accounts — Sprint 6 schema, Sprint 7 application code (no repository,
// service, or controller exists yet). Amendment 2.4 (.docs/06 §2.4): the
// schema snapshots bank details onto withdrawals but needs somewhere to
// store them so a seller isn't re-typing an account number on every
// request — the one operation where a typo sends money to a stranger.
model BankAccount {
  id                String    @id
  storeId           String    @map("store_id")
  bankCode          String    @map("bank_code")
  bankName          String    @map("bank_name")
  accountNumber     String    @map("account_number")
  accountHolderName String    @map("account_holder_name")
  isDefault         Boolean   @default(false) @map("is_default")
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  withdrawals Withdrawal[]

  @@map("bank_accounts")
}

// withdrawals — Sprint 6 schema, Sprint 7 application code. bank_account_snapshot
// freezes the destination at request time so a later account edit never
// alters a past withdrawal's record.
model Withdrawal {
  id                  String           @id
  storeId             String           @map("store_id")
  bankAccountId       String?          @map("bank_account_id")
  amount              BigInt
  status              WithdrawalStatus @default(requested)
  bankAccountSnapshot Json             @map("bank_account_snapshot")
  requestedAt         DateTime         @default(now()) @map("requested_at")
  approvedAt          DateTime?        @map("approved_at")
  rejectedAt          DateTime?        @map("rejected_at")
  paidAt              DateTime?        @map("paid_at")
  reviewedById        String?          @map("reviewed_by_id")
  adminNote           String?          @map("admin_note")

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  bankAccount         BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  reviewedBy          User?                @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  balanceTransactions BalanceTransaction[]

  @@index([status, requestedAt])
  @@map("withdrawals")
}

// audit_logs — migration 012 (.docs/03-bounded-contexts.md §3.13,
// .docs/brief/database-schema.md §audit_logs). actor_id is nullable and
// SET NULL on user deletion — the row (and its actor_type/action/entity
// trail) must survive even if the acting user's account is later removed.
model AuditLog {
  id         String    @id
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// invoices — Sprint 6 (migration 008). invoice_number is unique per store,
// not globally (a deviation from .docs/brief/database-schema.md's global
// unique, which is unsatisfiable alongside .docs/04 §7's "per-store
// sequential" — two stores would collide on their first invoice). store_id
// and rendered_at/snapshot are additions beyond the documented 7 columns:
// store_id avoids joining orders on every list page; rendered_at lets
// GET /invoices/:id/pdf return a precise "not ready yet" instead of an
// ambiguous 404 during the async PDF render window; snapshot freezes the
// full view model so a later product/store edit never alters an issued
// invoice (Invoice.fromOrder in the domain layer).
model Invoice {
  id            String          @id
  orderId       String          @unique @map("order_id")
  storeId       String          @map("store_id")
  invoiceNumber String          @map("invoice_number")
  pdfUrl        String?         @map("pdf_url")
  renderedAt    DateTime?       @map("rendered_at")
  sentVia       InvoiceSentVia? @map("sent_via")
  sentAt        DateTime?       @map("sent_at")
  snapshot      Json
  createdAt     DateTime        @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, invoiceNumber])
  @@index([storeId, createdAt])
  @@map("invoices")
}

// store_buyers — Sprint 6 (migration 010). The buyer database — CRM's owned
// table. Recomputed, never incremented, on every OrderPaid replay (see
// modules/crm's upsertOnPurchase SQL) so a redelivered webhook cannot
// inflate a buyer's lifetime spend. tags/notes are seller-entered and are
// never touched by the recompute. buyer_id -> users is RESTRICT: the CRM
// record must survive as long as the user exists.
model StoreBuyer {
  id              String   @id
  storeId         String   @map("store_id")
  buyerId         String   @map("buyer_id")
  firstPurchaseAt DateTime @map("first_purchase_at")
  lastPurchaseAt  DateTime @map("last_purchase_at")
  totalOrders     Int      @default(0) @map("total_orders")
  totalSpent      BigInt   @default(0) @map("total_spent")
  tags            String[] @default([])
  notes           String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@unique([storeId, buyerId])
  @@index([storeId, lastPurchaseAt])
  @@index([storeId, totalSpent])
  @@map("store_buyers")
}

// notification_deliveries — migration 017, pulled forward from Sprint 12
// (same move Sprint 5 made pulling migration 009 forward), because Sprint 6
// ships the NotificationChannel port + email adapter and every dispatch is
// row-first: nothing is sent without a persisted delivery record. The retry
// job and admin viewer stay Sprint 12 — this table is what they'll read.
model NotificationDelivery {
  id           String                     @id
  channel      NotificationChannelType
  provider     String
  recipient    String
  template     String
  payload      Json
  status       NotificationDeliveryStatus @default(pending)
  attempts     Int                        @default(0)
  errorMessage String?                    @map("error_message")
  sentAt       DateTime?                  @map("sent_at")
  createdAt    DateTime                   @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("notification_deliveries")
}
